{
  "expo": {
    "name": "remainderr",
    "slug": "remainderr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "remainderr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bladeofvolantis.remainderr"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      ["react-native-android-widget",{
        "widgets": [
          {
            "name": "widget", // This name will be the **name** with which we will reference our widget.
            "label": "My Widget", // Label shown in the widget picker
            "minWidth": "120dp",
            "minHeight": "40dp",
            "targetCellWidth": 2,
            "targetCellHeight": 1,
            "description": "This is my first widget", // Description shown in the widget picker
            "previewImage": "./assets/images/icon.png", // Path to widget preview image
            "updatePeriodMillis": 1800000 ,  // Minimum is 1800000 (30 minutes == 30 * 60 * 1000).
            "resizeMode" : "horizontal|vertical"
    }]
      }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
